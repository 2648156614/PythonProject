DB_POOL_RESET_SESSION=true
UPGRADE_LEGACY_PASSWORD_ON_LOGIN=false
PROBLEM_TTL_SECONDS=900
PROBLEM_POOL_TARGET_SIZE=20
PROBLEM_POOL_REFILL_BATCH=10
